{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AbsaOSS/agentic-toolkit/skills/shared/references/schemas/manifest.schema.json",
  "title": "Exploration Manifest (manifest.json)",
  "description": "Canonical machine contract for .copilot/bdd/manifest.json. routes is a JSON array. Element and coverage_gap objects enforce strict schemas: 'data-cy' and camelCase 'suggestedDataCy' with additionalProperties:false prevent snake_case at object level. Route and manifest levels allow additional properties. See living-doc-bdd-schemas.md > manifest.json.",
  "type": "object",
  "required": ["generated", "scan_version", "routes"],
  "additionalProperties": true,
  "properties": {
    "generated": { "type": "string", "minLength": 1 },
    "scan_version": { "type": "string", "minLength": 1 },
    "routes": {
      "type": "array",
      "items": { "$ref": "#/definitions/route" }
    }
  },
  "definitions": {
    "route": {
      "type": "object",
      "required": [
        "url",
        "title",
        "pageobject_path",
        "feature_id",
        "last_scanned",
        "elements",
        "coverage_gaps",
        "navigation_context"
      ],
      "additionalProperties": true,
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "pageobject_path": { "type": "string", "minLength": 1 },
        "feature_id": { "type": "string", "pattern": "^FEAT-(\\d{3,}|UNKNOWN)$" },
        "last_scanned": { "type": "string", "minLength": 1 },
        "note": { "type": "string" },
        "navigation_context": {
          "type": "string",
          "description": "Prose string — NOT an object. How to reach the route."
        },
        "elements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["data-cy", "tag"],
            "additionalProperties": false,
            "properties": {
              "data-cy": { "type": "string", "minLength": 1 },
              "tag": { "type": "string", "minLength": 1 },
              "label": { "type": ["string", "null"] },
              "note": { "type": "string" }
            }
          }
        },
        "coverage_gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tag", "suggestedDataCy"],
            "additionalProperties": false,
            "anyOf": [
              { "required": ["text"] },
              { "required": ["ariaLabel"] },
              { "required": ["role"] },
              { "required": ["type"] }
            ],
            "properties": {
              "tag": { "type": "string" },
              "text": { "type": "string" },
              "ariaLabel": { "type": "string" },
              "role": { "type": "string" },
              "type": { "type": "string" },
              "suggestedDataCy": { "type": "string", "minLength": 1 },
              "note": { "type": "string" }
            }
          }
        },
        "open_actions_menu": { "type": "object" },
        "field_constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field"],
            "additionalProperties": true,
            "properties": {
              "field": { "type": "string" },
              "max_length": { "type": "integer" },
              "special_chars": { "type": "string" },
              "duplicate": { "type": "string" },
              "duplicate_error_data_cy": { "type": "string" },
              "allowed_format": { "type": "string" },
              "real_world_required": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
