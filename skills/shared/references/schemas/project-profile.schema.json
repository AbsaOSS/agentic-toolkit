{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AbsaOSS/agentic-toolkit/skills/shared/references/schemas/project-profile.schema.json",
  "title": "Project Profile",
  "description": "Config-driven conventions loaded by the living-doc-bdd agent at session start. Canonical machine contract for .copilot/bdd/.project-profile.yaml. See living-doc-bdd-schemas.md > Project Profile.",
  "type": "object",
  "required": [
    "test_id_attribute",
    "feature_dirs",
    "paths"
  ],
  "additionalProperties": true,
  "not": {
    "required": ["pageobject_statuses"]
  },
  "properties": {
    "test_id_attribute": {
      "type": "string",
      "minLength": 1,
      "description": "Attribute page.getByTestId() resolves to (Playwright testIdAttribute), e.g. data-cy."
    },
    "feature_dirs": {
      "type": "object",
      "required": ["user_story", "functionality"],
      "additionalProperties": false,
      "properties": {
        "user_story": { "type": "string", "minLength": 1 },
        "functionality": { "type": "string", "minLength": 1 }
      }
    },
    "paths": {
      "type": "object",
      "required": ["bdd_artifacts", "pageobjects", "steps"],
      "additionalProperties": true,
      "properties": {
        "bdd_artifacts": { "type": "string", "minLength": 1 },
        "pageobjects": { "type": "string", "minLength": 1 },
        "steps": { "type": "string", "minLength": 1 }
      }
    },
    "ac_states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["planned", "in_review", "active", "deprecated"]
      },
      "uniqueItems": true,
      "description": "AC state vocabulary — a subset of the four canonical states, lowercase with underscores. Omitting this field is allowed; no other spelling or extra state is accepted. There is no PageObject status vocabulary — PageObject headers carry no `status:` field at all."
    },
    "scenario_conventions": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "feature_tag": { "type": "boolean" },
        "domain_tag": { "type": "boolean" },
        "suite_tags": {
          "type": "array",
          "items": { "type": "string", "pattern": "^@" }
        },
        "section_banners": { "type": "boolean" }
      }
    },
    "manifest_shape": {
      "type": "string",
      "enum": ["object"],
      "description": "Manifest is a JSON object with routes array (generated, scan_version, routes keys)."
    }
  }
}
