+"""Scans a Python module for field names matching common PII patterns."""
+import re
+import sys
+
+PII_PATTERNS = [r"\bemail\b", r"\bphone\b", r"\bfull_name\b", r"\bnational_id\b"]
+
+
+def scan(filepath: str) -> list[str]:
+    with open(filepath) as f:
+        content = f.read()
+    return [p for p in PII_PATTERNS if re.search(p, content)]
+
+
+if __name__ == "__main__":
+    print(scan(sys.argv[1]))
