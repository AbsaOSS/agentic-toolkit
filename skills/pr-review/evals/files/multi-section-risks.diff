+"""rename email to contact_email and add notification_opt_in
+
+Revision ID: a3f7c2e1d904
+Revises: b1d0e4f2c803
+"""
+from alembic import op
+import sqlalchemy as sa
+
+def upgrade():
+    # Add new column
+    op.add_column('users', sa.Column('contact_email', sa.String(255), nullable=False))
+    # Drop old column in same migration — data not backfilled
+    op.drop_column('users', 'email')
+    # Add non-nullable column with no server default
+    op.add_column('users', sa.Column('notification_opt_in', sa.Boolean(), nullable=False))
+
+def downgrade():
+    raise NotImplementedError("Downgrade not supported")
+
