+#!/usr/bin/env bash
+# Runs the data transformation pipeline on a given input file.
+set -euo pipefail
+
+INPUT_FILE="${1:?Usage: run_transform.sh <input_file>}"
+
+python3 -m data_transformer.pipeline --input "$INPUT_FILE"
+echo "Transformation complete."
