---
/**
 * Custom landing page. Rendered inside StarlightPage so the site header
 * (search, theme toggle, GitHub link) stays consistent with doc pages.
 * All catalog data is pulled from the content collection at build time —
 * the page stays in sync with whatever fetch-content.mjs produces.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
import { repoUrl } from '../../site.config.mjs';

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path) => `${BASE}${path}`;

const docs = await getCollection('docs');
const skills = docs
  .filter((d) => d.slug.startsWith('skills/') && d.slug !== 'skills/index')
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const guides = docs
  .filter((d) => d.slug.startsWith('guidelines/') && d.slug !== 'guidelines/index')
  .sort((a, b) => (a.data.sidebar?.order ?? 99) - (b.data.sidebar?.order ?? 99));

const installCmd = `npx skills add ${repoUrl} -g`;

const steps = [
  {
    n: '01',
    title: 'Install once',
    text: 'One command pulls the skills into your global or project agent space. Works with any Agent Skills compatible client.',
  },
  {
    n: '02',
    title: 'Agent loads on demand',
    text: 'Skills carry trigger descriptions. Your agent reads them and loads the right skill only when the task calls for it — zero context wasted otherwise.',
  },
  {
    n: '03',
    title: 'Every session inherits',
    text: 'Team conventions, proven workflows, domain knowledge — baked into each new session instead of re-explained from scratch.',
  },
];

const props = [
  {
    icon: 'M12 2 2 7l10 5 10-5-10-5Zm-10 10 10 5 10-5M2 17l10 5 10-5',
    title: 'One install, every tool',
    text: 'Built on the open Agent Skills standard. GitHub Copilot, Claude Code, Cursor — the same skill works everywhere, no per-tool rewrites.',
  },
  {
    icon: 'M9 12l2 2 4-4m5.6 2a9.6 9.6 0 1 1-19.2 0 9.6 9.6 0 0 1 19.2 0Z',
    title: 'Curated, not scraped',
    text: 'Each skill ships with an evaluation suite and authoring guidelines. Trigger accuracy is measured before anything merges.',
  },
  {
    icon: 'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm14 10v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75',
    title: 'Community-driven',
    text: 'Open source under AbsaOSS. Contribute skills, improve existing ones, or merge content from your own repositories at build time.',
  },
];
---

<StarlightPage
  frontmatter={{
    title: 'Agentic Toolkit',
    description:
      'Curated, reusable AI skills — domain knowledge and proven workflows for any Agent Skills compatible client.',
    template: 'splash',
    tableOfContents: false,
    editUrl: false,
    pagefind: false,
  }}
>
  <div class="at-landing not-content">
    <!-- ───────────────────────── Hero ───────────────────────── -->
    <section class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="pulse-dot" aria-hidden="true"></span>
          Open source · Agent Skills standard
        </p>
        <h1>
          AI agents start from zero.<br />
          <em>Yours doesn't have to.</em>
        </h1>
        <p class="lede">
          A curated library of <strong>skills</strong> — domain knowledge,
          engineering patterns, and proven workflows your AI assistant loads on
          demand. Install once, use in Copilot, Claude Code, Cursor, and any
          Agent Skills compatible client.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href={href('/skills/')}>
            Browse skills
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3 8h10m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a class="btn btn-ghost" href={href('/guidelines/getting-started/')}>Getting started</a>
        </div>
        <div class="install-line">
          <code id="install-cmd">{installCmd}</code>
          <button class="copy-btn" data-copy={installCmd} aria-label="Copy install command">
            <svg class="ic-copy" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><rect x="5" y="5" width="9" height="9" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
            <svg class="ic-check" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="m3 8.5 3.5 3.5L13 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>

      <div class="hero-term" aria-hidden="true">
        <div class="term">
          <div class="term-bar">
            <span class="dot d1"></span><span class="dot d2"></span><span class="dot d3"></span>
            <span class="term-title">agent session</span>
          </div>
          <div class="term-body">
            <p class="tl" style="--i:0"><span class="ps">$</span> npx skills add AbsaOSS/agentic-toolkit -g</p>
            <p class="tl ok" style="--i:1"><span class="tick">✔</span> create-issue <span class="dim">— installed</span></p>
            <p class="tl ok" style="--i:2"><span class="tick">✔</span> token-saving <span class="dim">— installed</span></p>
            <p class="tl" style="--i:3"><span class="ps">$</span> copilot</p>
            <p class="tl" style="--i:4"><span class="ps ai">›</span> file a bug for the flaky login test</p>
            <p class="tl ok" style="--i:5"><span class="tick">⚡</span> skill <span class="hl">create-issue</span> loaded</p>
            <p class="tl ok" style="--i:6"><span class="tick">✔</span> issue <span class="hl">#214</span> created from bug template<span class="cursor"></span></p>
          </div>
        </div>
        <div class="term-glow"></div>
      </div>
    </section>

    <!-- ──────────────────── Tools strip ──────────────────── -->
    <section class="tools-strip" aria-label="Compatible tools">
      <span class="strip-label">Works with</span>
      <ul>
        <li>GitHub Copilot</li>
        <li>Claude Code</li>
        <li>Cursor</li>
        <li class="strip-more">+ any Agent Skills client</li>
      </ul>
    </section>

    <!-- ──────────────────── Value props ──────────────────── -->
    <section class="props">
      {props.map((p) => (
        <article class="prop-card">
          <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d={p.icon} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </article>
      ))}
    </section>

    <!-- ──────────────────── How it works ──────────────────── -->
    <section class="how">
      <header class="sec-head">
        <h2>How it works</h2>
        <p>Skills are folders of instructions and resources an agent loads on demand — the lowest-friction, highest-value layer of agentic tooling.</p>
      </header>
      <ol class="steps">
        {steps.map((s) => (
          <li>
            <span class="step-n">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- ──────────────────── Skills catalog ──────────────────── -->
    <section class="catalog">
      <header class="sec-head row">
        <div>
          <h2>Skill catalog</h2>
          <p>{skills.length} production-ready skill{skills.length === 1 ? '' : 's'}, each with evaluation coverage.</p>
        </div>
        <a class="all-link" href={href('/skills/')}>
          View all
          <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path d="M3 8h10m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </header>
      <div class="skill-grid">
        {skills.map((s) => (
          <a class="skill-card" href={href(`/${s.slug}/`)}>
            <span class="skill-name"><span class="slash">/</span>{s.slug.replace('skills/', '')}</span>
            <p>{s.data.description}</p>
            <span class="skill-go" aria-hidden="true">
              <svg viewBox="0 0 16 16" width="14" height="14"><path d="M3 8h10m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </a>
        ))}
        <a class="skill-card skill-card-add" href={`${repoUrl}/blob/master/CONTRIBUTING.md`}>
          <span class="skill-name dashed">your-skill</span>
          <p>Have a workflow worth sharing? The contributing guide covers folder layout, frontmatter, and the PR process.</p>
          <span class="skill-go" aria-hidden="true">＋</span>
        </a>
      </div>
    </section>

    <!-- ──────────────────── Guides ──────────────────── -->
    <section class="guides">
      <header class="sec-head row">
        <div>
          <h2>Guides</h2>
          <p>From first install to authoring and testing your own skills.</p>
        </div>
        <a class="all-link" href={href('/guidelines/')}>
          View all
          <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path d="M3 8h10m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </header>
      <ol class="guide-list">
        {guides.map((g, i) => (
          <li>
            <a href={href(`/${g.slug}/`)}>
              <span class="guide-n">{String(i + 1).padStart(2, '0')}</span>
              <span class="guide-title">{g.data.title}</span>
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3 8h10m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <!-- ──────────────────── Final CTA ──────────────────── -->
    <section class="cta-band">
      <h2>Stop re-explaining.<br />Start every session ahead.</h2>
      <div class="install-line big">
        <code>{installCmd}</code>
        <button class="copy-btn" data-copy={installCmd} aria-label="Copy install command">
          <svg class="ic-copy" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><rect x="5" y="5" width="9" height="9" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
          <svg class="ic-check" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="m3 8.5 3.5 3.5L13 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
      <p class="cta-sub">
        Free and open source ·
        <a href={repoUrl}>Star on GitHub</a> ·
        <a href={href('/guidelines/contributing/')}>Contribute a skill</a>
      </p>
    </section>
  </div>
</StarlightPage>

<script>
  for (const btn of document.querySelectorAll('.copy-btn')) {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        btn.classList.add('copied');
        setTimeout(() => btn.classList.remove('copied'), 1600);
      } catch {
        /* clipboard unavailable (insecure context) — silently ignore */
      }
    });
  }
</script>

<style is:global>
  /* Hide the default title panel StarlightPage renders above the slot —
     the landing supplies its own hero heading. (This style is bundled only
     with the index route, so doc pages keep their titles.) */
  main .content-panel:has(h1#_top) {
    display: none;
  }

  main .content-panel + .content-panel {
    border-top: none !important;
  }
</style>

<style>
  /* ════ Layout shell ════ */
  .at-landing {
    --land-border: rgba(255, 120, 15, 0.12);
    --land-border-soft: color-mix(in srgb, var(--sl-color-gray-4) 35%, transparent);
    --land-card: color-mix(in srgb, var(--sl-color-gray-6) 55%, transparent);
    --land-mono: 'JetBrains Mono', ui-monospace, monospace;
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem 5rem;
    font-family: var(--sl-font);
  }

  section { margin-top: 6rem; }
  .hero-grid { margin-top: 3.5rem; }

  /* ════ Hero ════ */
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 3.5rem;
    align-items: center;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--land-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--at-orange);
    border: 1px solid var(--land-border);
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
    background: var(--at-glow);
    animation: rise 0.6s ease-out both;
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--at-orange);
    animation: pulse 2.2s ease-in-out infinite;
  }

  h1 {
    font-family: var(--at-display);
    font-weight: 800;
    font-size: clamp(2.6rem, 5.2vw, 4.2rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
    margin: 1.4rem 0 0;
    color: var(--sl-color-white);
    animation: rise 0.6s ease-out 0.08s both;
  }

  h1 em {
    font-style: normal;
    background: linear-gradient(120deg, var(--at-orange), var(--at-amber));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .lede {
    margin-top: 1.4rem;
    max-width: 46ch;
    font-size: clamp(1.02rem, 1.5vw, 1.18rem);
    line-height: 1.7;
    color: var(--sl-color-gray-2);
    animation: rise 0.6s ease-out 0.16s both;
  }

  .lede strong { color: var(--sl-color-white); }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2rem;
    animation: rise 0.6s ease-out 0.24s both;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.7rem;
    border-radius: 10px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    transition: transform 0.18s ease, box-shadow 0.25s ease, background 0.2s ease, border-color 0.2s ease;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--at-orange), #e06500);
    color: #fff;
    box-shadow: 0 4px 20px rgba(255, 120, 15, 0.35);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(255, 120, 15, 0.5);
  }

  .btn-ghost {
    border: 1.5px solid var(--at-card-border-hover);
    color: var(--sl-color-white);
  }

  .btn-ghost:hover {
    background: var(--at-glow);
    border-color: var(--at-orange);
    transform: translateY(-1px);
  }

  /* ════ Install one-liner ════ */
  .install-line {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.6rem;
    border: 1px solid var(--land-border);
    border-radius: 10px;
    background: var(--land-card);
    padding: 0.55rem 0.55rem 0.55rem 1rem;
    animation: rise 0.6s ease-out 0.32s both;
    max-width: 100%;
  }

  .install-line code {
    font-family: var(--land-mono);
    font-size: 0.86rem;
    color: var(--sl-color-gray-1);
    background: none;
    overflow-x: auto;
    white-space: nowrap;
  }

  .install-line code::before { content: '$ '; color: var(--at-orange); }

  .copy-btn {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--land-border-soft);
    border-radius: 7px;
    background: transparent;
    color: var(--sl-color-gray-2);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .copy-btn:hover { color: var(--at-orange); border-color: var(--at-orange); }
  .copy-btn .ic-check { display: none; }
  .copy-btn.copied .ic-copy { display: none; }
  .copy-btn.copied .ic-check { display: block; color: #4ade80; }

  /* ════ Terminal mock ════ */
  .hero-term { position: relative; animation: rise 0.7s ease-out 0.2s both; }

  .term {
    position: relative;
    z-index: 1;
    border: 1px solid var(--land-border);
    border-radius: 14px;
    background: color-mix(in srgb, var(--sl-color-black) 88%, transparent);
    box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.6);
    overflow: hidden;
  }

  .term-bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--land-border-soft);
  }

  .dot { width: 10px; height: 10px; border-radius: 50%; }
  .d1 { background: #ff5f57; } .d2 { background: #febc2e; } .d3 { background: #28c840; }

  .term-title {
    margin-left: auto;
    font-family: var(--land-mono);
    font-size: 0.7rem;
    color: var(--sl-color-gray-3);
    letter-spacing: 0.06em;
  }

  .term-body { padding: 1.1rem 1.2rem 1.3rem; }

  .tl {
    font-family: var(--land-mono);
    font-size: 0.8rem;
    line-height: 2;
    margin: 0;
    color: var(--sl-color-gray-1);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    opacity: 0;
    animation: termIn 0.4s ease-out both;
    animation-delay: calc(0.5s + var(--i) * 0.45s);
  }

  .ps { color: var(--at-orange); margin-right: 0.5ch; }
  .ps.ai { color: var(--at-amber); }
  .tick { color: #4ade80; margin-right: 0.5ch; }
  .dim { color: var(--sl-color-gray-3); }
  .hl { color: var(--at-amber); }

  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    margin-left: 0.3ch;
    vertical-align: text-bottom;
    background: var(--at-orange);
    animation: blink 1.1s steps(2) infinite;
  }

  .term-glow {
    position: absolute;
    inset: -12% -8%;
    z-index: 0;
    background: radial-gradient(ellipse 60% 55% at 50% 50%, var(--at-glow-strong), transparent 70%);
    pointer-events: none;
  }

  /* ════ Tools strip ════ */
  .tools-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: 4.5rem;
    padding: 1.1rem 1.5rem;
    border-block: 1px solid var(--land-border-soft);
  }

  .strip-label {
    font-family: var(--land-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--sl-color-gray-3);
  }

  .tools-strip ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 2.2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tools-strip li {
    font-family: var(--at-display);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--sl-color-gray-2);
  }

  .strip-more { color: var(--sl-color-gray-3); font-weight: 400; font-size: 0.95rem; }

  /* ════ Value props ════ */
  .props {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .prop-card {
    border: 1px solid var(--at-card-border);
    border-radius: 14px;
    background: var(--at-card-bg);
    padding: 1.8rem 1.6rem;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.3s ease;
  }

  .prop-card:hover {
    transform: translateY(-4px);
    border-color: var(--at-card-border-hover);
    box-shadow: 0 12px 40px var(--at-glow);
  }

  .prop-card svg { color: var(--at-orange); }

  .prop-card h3 {
    font-family: var(--at-display);
    font-size: 1.18rem;
    font-weight: 600;
    margin: 1rem 0 0.5rem;
    color: var(--sl-color-white);
  }

  .prop-card p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--sl-color-gray-2);
  }

  /* ════ Section headers ════ */
  .sec-head h2 {
    font-family: var(--at-display);
    font-weight: 800;
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    letter-spacing: -0.03em;
    margin: 0;
    color: var(--sl-color-white);
  }

  .sec-head p {
    margin: 0.6rem 0 0;
    max-width: 56ch;
    color: var(--sl-color-gray-2);
    line-height: 1.65;
  }

  .sec-head.row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--at-orange);
    text-decoration: none;
    transition: gap 0.2s ease;
  }

  .all-link:hover { gap: 0.65rem; }

  /* ════ How it works ════ */
  .how .sec-head { margin-bottom: 2.5rem; }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--land-border-soft);
  }

  .steps li {
    padding: 2rem 2rem 0 0;
    position: relative;
  }

  .steps li + li { border-left: 1px solid var(--land-border-soft); padding-left: 2rem; }

  .step-n {
    font-family: var(--land-mono);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--at-orange);
  }

  .steps h3 {
    font-family: var(--at-display);
    font-size: 1.25rem;
    font-weight: 600;
